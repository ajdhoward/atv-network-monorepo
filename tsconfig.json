{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "skipLibCheck": true,
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["services/atv-core/src/**/*", "services/atv-core/test/**/*"],
  "exclude": ["node_modules", ".wrangler", "dist"]
}
