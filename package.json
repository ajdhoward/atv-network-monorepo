{
  "name": "atv-network-monorepo",
  "private": true,
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "typecheck": "tsc --noEmit && pnpm --filter @atv/tv-client typecheck && pnpm --filter @atv/admin-cms typecheck",
    "build:client": "pnpm --filter @atv/tv-client build",
    "build:admin": "pnpm --filter @atv/admin-cms build",
    "build:deploy": "pnpm run build:client && pnpm run build:admin && node scripts/pack-assets.mjs",
    "dev": "node scripts/dev.mjs",
    "ci:worker": "node scripts/ci-worker.mjs",
    "kv:staging": "node scripts/staging-kv.mjs",
    "seed": "node scripts/seed-kv.mjs",
    "seed:local": "node scripts/seed-kv.mjs --local",
    "budget": "node scripts/budget.mjs",
    "handoff": "node scripts/handoff.mjs",
    "smoke": "node scripts/smoke.mjs",
    "streams": "node scripts/check-streams.mjs",
    "deploy": "node scripts/staging-kv.mjs && node scripts/check-deploy-target.mjs wrangler.toml && pnpm run build:deploy && wrangler deploy --config wrangler.toml",
    "deploy:prod": "node scripts/check-deploy-target.mjs wrangler.production.toml && pnpm run build:deploy && wrangler deploy --config wrangler.production.toml",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "kv:copy": "node scripts/copy-kv.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@eslint/js": "^9.39.5",
    "eslint": "^9",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.136.1"
  }
}
