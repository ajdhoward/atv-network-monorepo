{
  "name": "atv-network-monorepo",
  "version": "5.0.0",
  "private": true,
  "description": "ATV Network \u2014 Self-provisioning + Master 3.0 + Bespoke sideloadable. Deploy with one click.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.workers.json",
    "lint": "eslint .",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "deploy:all": "bash scripts/deploy-all.sh",
    "validate:all": "bash scripts/validate-all.sh"
  },
  "devDependencies": {
    "wrangler": "^4.136.2",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "eslint": "^9.10.0"
  },
  "cloudflare": {
    "bindings": {
      "ATV_ADMIN_TOKEN": {
        "description": "Admin token - openssl rand -hex 32"
      },
      "TMDB_API_KEY": {
        "description": "TMDB key"
      },
      "GEMINI_API_KEY": {
        "description": "Gemini key"
      },
      "OPENROUTER_API_KEY": {
        "description": "OpenRouter key"
      }
    }
  }
}