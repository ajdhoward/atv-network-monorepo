node_modules/
.wrangler/
dist/

# Android build output and the local SDK path. The APK ships as a release asset
# and a signing keystore lives in repository secrets, never in the tree.
android/.gradle/
android/build/
android/app/build/
android/local.properties
*.apk
*.jks
*.p12
.env
# Wrangler's local secrets file. `wrangler dev` loads it, so this is exactly where a
# developer's TorBox token or stream map would sit — and this repository is public.
# The `.example` template carries the names and no values, so it is tracked.
.dev.vars
.dev.vars.*
!.dev.vars.example
*.log
.DS_Store

# Seed lineup: channel ids and stream URLs must not land in this public repo.
atv-config.json
